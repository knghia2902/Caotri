# ==========================================
# Database Connection URL
# ==========================================

# 1. Local SQLite (Mặc định cho môi trường dev nhanh, không cần cài server)
DATABASE_URL="file:./dev.db"

# 2. Supabase PostgreSQL / Cloud PostgreSQL (Dùng khi deploy production)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ==========================================
# NextAuth / JWT Authentication (Phase 2)
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="caotri-super-secret-key-replace-in-production-12345678"

# ==========================================
# Cloudinary / Supabase Storage (Phase 3)
# ==========================================
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
