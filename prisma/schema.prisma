datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  password         String
  name             String
  role             String          @default("STAFF") // "ADMIN" | "STAFF"
  createdOrders    Order[]         @relation("OrderCreatedBy")
  createdCashflows CashflowEntry[] @relation("CashflowCreatedBy")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  orderIndex  Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  shortDescription String?  // Mô tả ngắn hiển thị cạnh ảnh / trên chính sách
  description   String?     // Mô tả chi tiết hiển thị ở tab dưới
  price         Float
  originalPrice Float?
  images        String      @default("[]") // JSON string of image URLs
  specs         String?     // JSON string of specs e.g. {"DPI": "32000", "Weight": "60g"}
  inStock       Boolean     @default(true)
  isFeatured    Boolean     @default(false)
  isNew         Boolean     @default(true)
  isArchived    Boolean     @default(false) // Lưu kho nội bộ, ẩn khỏi storefront bên ngoài
  costPrice     Float?      // Giá thu vào / vốn mua hàng (Chỉ nội bộ Admin)
  internalNote  String?     // Ghi chú thu, bán, trade, nguồn hàng (Chỉ nội bộ Admin)
  warrantyNote  String?     // Ghi chú bảo hành, số seri, hóa đơn (Chỉ nội bộ Admin)
  warrantyImages String?    @default("[]") // Ảnh chụp bảo hành, số seri, hóa đơn (Chỉ nội bộ Admin)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique // e.g. "DH-100234"
  customerName    String
  customerPhone   String
  customerAddress String
  customerNotes   String?
  adminNotes      String?
  totalAmount     Float
  status          String          @default("PENDING") // "PENDING" | "CONTACTED" | "SHIPPING" | "COMPLETED" | "CANCELLED"
  channel         String          @default("WEB") // "WEB" | "OFFLINE" | "ZALO" | "FACEBOOK" | "OTHER"
  paymentMethod   String          @default("COD") // "COD" | "CASH" | "BANK_TRANSFER" | "OTHER"
  discount        Float           @default(0)
  shippingFee     Float           @default(0)
  soldAt          DateTime?
  createdById     String?
  createdBy       User?           @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items           OrderItem[]
  cashflowEntries CashflowEntry[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, soldAt])
  @@index([channel, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  price       Float
  costPrice   Float?   // Snapshot giá vốn tại thời điểm bán (null = chưa nhập giá vốn)
  quantity    Int      @default(1)
}

model CashflowEntry {
  id            String   @id @default(cuid())
  type          String   // "IN" | "OUT"
  category      String   // IN: ORDER_SALE | OFFLINE_SALE | OTHER_IN; OUT: INVENTORY_IMPORT | SHIPPING | MARKETING | OPERATING | SALARY | REFUND | OTHER_OUT
  amount        Float
  paymentMethod String   @default("CASH") // "CASH" | "BANK_TRANSFER" | "COD" | "OTHER"
  occurredAt    DateTime @default(now())
  dateKey       String   // "YYYY-MM-DD" theo múi giờ Việt Nam (UTC+7)
  note          String?
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?    @relation("CashflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dateKey])
  @@index([type, dateKey])
  @@index([category, dateKey])
  @@index([orderId])
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  imageUrl   String
  linkUrl    String?
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DailyVisitor {
  id         String   @id @default(cuid())
  date       String   // Format: "YYYY-MM-DD" theo múi giờ Việt Nam (UTC+7)
  visitorId  String   // Token định danh trình duyệt/máy tính (Cookie tg_vid)
  ipHash     String   // Hash SHA-256 của IP khách để chống spam F5/mở tab mới
  userAgent  String?
  deviceType String?  // "Desktop" | "Mobile" | "Tablet"
  pageviews  Int      @default(1)
  lastPath   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([visitorId, date])
  @@index([ipHash, date])
  @@index([date])
}

model TrafficStat {
  date       String   @id // Format: "YYYY-MM-DD"
  visitors   Int      @default(0) // Số khách truy cập duy nhất trong ngày (Unique Visitors)
  pageviews  Int      @default(0) // Tổng số lượt xem trang trong ngày (Pageviews)
  updatedAt  DateTime @updatedAt
}

model PageviewStat {
  id        String   @id @default(cuid())
  path      String   @unique // URL đường dẫn: "/", "/product/...", "/category/..."
  title     String?
  views     Int      @default(1)
  updatedAt DateTime @updatedAt
}
