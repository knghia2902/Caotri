{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caotri",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "caotri"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caotri-db",
      "database_id": "79b44069-038c-4e37-a87d-53cb37447b8e"
    }
  ]
}
